# Resend API Key
# Obtén tu API key en: https://resend.com/api-keys
RESEND_API_KEY=tu_api_key_aqui

# Google reCAPTCHA v3
# Registra tu sitio en: https://www.google.com/recaptcha/admin/create
# Site Key (pública - va en el frontend)
VITE_RECAPTCHA_SITE_KEY=tu_site_key_aqui
# Secret Key (privada - solo backend)
RECAPTCHA_SECRET_KEY=tu_secret_key_aqui
